# One image contains the shared core and all providers; PROVIDER selects the runtime.
SDLC_MCP_IMAGE=sdlc-mcp-server:dev

# Loopback development only. Shared environments must enable OIDC and TLS.
ENABLE_OIDC=false
ENABLE_TLS=false

FORGEJO_MCP_PORT=3010
FORGEJO_URL=http://host.docker.internal:3000
FORGEJO_ALLOW_INSECURE_HTTP=true
SDLC_ALLOWED_REPOSITORIES=owner/repository
SDLC_ENABLE_WRITES=false

WIKIJS_MCP_PORT=3011
WIKIJS_MCP_URL=http://host.docker.internal:3001/_mcp
WIKIJS_ALLOW_INSECURE_MCP_HTTP=true

# Required when ENABLE_OIDC=true for Forgejo or Wiki.js.
MCP_OIDC_ISSUER=
MCP_OIDC_REQUIRED_REALM_ROLE=mcp-user
FORGEJO_MCP_PUBLIC_URL=http://127.0.0.1:3010/mcp
FORGEJO_MCP_OIDC_AUDIENCE=
WIKIJS_MCP_PUBLIC_URL=http://127.0.0.1:3011/mcp
WIKIJS_MCP_OIDC_AUDIENCE=

# Home Assistant always requires OIDC plus a configured HTTPS upstream.
HOMEASSISTANT_MCP_PORT=3012
HOMEASSISTANT_MCP_OIDC_AUDIENCE=
HOMEASSISTANT_MCP_OIDC_REQUIRED_GROUP=home-assistant-users
MCP_OIDC_DISCOVERY_CLIENT_ID=mcp-gateway-discovery
HOMEASSISTANT_MCP_PUBLIC_URL=http://127.0.0.1:3012/mcp
HOMEASSISTANT_PUBLIC_URL=
HOMEASSISTANT_INTERNAL_URL=https://home-assistant-upstream-tls
HOMEASSISTANT_TOKEN_ENCRYPTION_KEY=
HOMEASSISTANT_DISCOVERY_SUBJECT_FILE_HOST=./.data/homeassistant-discovery.id
