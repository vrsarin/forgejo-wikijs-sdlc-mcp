# Standalone Forgejo and Wiki.js server development defaults. Never use these settings on an exposed network.
ENABLE_OIDC=false
ENABLE_TLS=false

# Forgejo MCP (HTTP development server)
FORGEJO_URL=http://127.0.0.1:3000
FORGEJO_ALLOW_INSECURE_HTTP=true
FORGEJO_ACCESS_TOKEN=replace-with-a-read-only-token
SDLC_ALLOWED_REPOSITORIES=owner/repository
SDLC_ENABLE_WRITES=false

# Wiki.js MCP (HTTP development server)
WIKIJS_MCP_URL=http://127.0.0.1:3001/_mcp
WIKIJS_ALLOW_INSECURE_MCP_HTTP=true
WIKIJS_ACCESS_TOKEN=replace-with-a-read-only-token

# Direct HTTP listeners used by editor clients. Home Assistant retains its OIDC requirements.
FORGEJO_MCP_URL=http://127.0.0.1:3010/mcp
WIKIJS_SDLC_MCP_URL=http://127.0.0.1:3011/mcp
HOMEASSISTANT_MCP_URL=http://127.0.0.1:3012/mcp
